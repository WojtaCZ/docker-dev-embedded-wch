{
    "_note": "Copied to .mcu-profile.json by /scaffold-mcu-project wch. Works with ch32v003fun Makefile projects. Adjust for CMake-based projects.",
    "build":      "make -j$(nproc)",
    "buildDebug": "make -j$(nproc) DEBUG=1",
    "clean":      "make clean",
    "flash":      "wlink flash build/firmware.bin",
    "erase":      "wlink erase chip",
    "reset":      "wlink reset",
    "serial":     "picocom -b ${BAUD:-115200} ${PORT:-/dev/ttyACM0}",
    "debugServer":"openocd -f interface/wlink-rs.cfg -f target/wch-riscv.cfg"
}
